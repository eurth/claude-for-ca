# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=for-ca
ENVIRONMENT=production
API_PORT=8000
WEB_ORIGIN=https://ca.eurthtech.com
JWT_SECRET=change-me-in-coolify
JWT_HOURS=12

# ── Database (Coolify Postgres resource) ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg://forca:forca@db:5432/forca

# ── Files (Docker volume /data/ca-practice-data → /app/data) ──────────────────
DATA_DIR=/app/data

# ── Seed Gorantla partner on first boot ───────────────────────────────────────
SEED_FIRM_NAME=Gorantla Associates
SEED_CA_NAME=CA Butchi Babu
SEED_PARTNER_EMAIL=partner@gorantla.local
SEED_PARTNER_PASSWORD=change-me-on-first-login
SEED_HITL_THRESHOLD=100000

# ── LLM gateway (leave blank to use mock provider) ────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_LOW=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_HIGH=nvidia/nemotron-3-super-120b-a12b:free
